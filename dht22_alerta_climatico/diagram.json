{
  "version": 1,
  "author": "Silvio",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {
        "serialInterface": "USB_SERIAL_JTAG"
      }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -10,
      "left": 280,
      "attrs": {
        "temperature": "25",
        "humidity": "55"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -80,
      "left": 200,
      "attrs": {
        "value": "10000"
      }
    }
  ],
  "connections": [
    [ "esp:3V3", "dht1:VCC", "red", [ "h0" ] ],
    [ "esp:GND.1", "dht1:GND", "black", [ "h0" ] ],

    [ "esp:17", "dht1:SDA", "green", [ "h0" ] ],

    [ "esp:3V3", "r1:1", "red", [ "h0" ] ],
    [ "r1:2", "dht1:SDA", "green", [ "h0" ] ]
  ],
  "dependencies": {}
}